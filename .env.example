# Synthetic local-development values only. Never commit .env.
APP_ENV=development
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-local-secret
DATABASE_URL=postgresql://habit:habit@localhost:5433/habit_tracker
TEST_DATABASE_URL=postgresql://habit:habit@localhost:5433/habit_tracker_test
SESSION_TTL=24
# Legacy alias accepted by the API; use SESSION_TTL for new deployments.
# SESSION_MAX_AGE_HOURS=24
APP_TIMEZONE=Asia/Bangkok
SEED_DEMO_PASSWORD=replace-with-a-local-demo-password
PORT=3000
HOST=0.0.0.0
